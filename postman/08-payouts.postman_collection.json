{
  "info": {
    "name": "Inttegro API — Payouts",
    "description": "Configure, schedule, retrieve, and cancel payouts. Uses the shared Inttegro API global environment.\n\nGenerated from insomnia/08-payouts.insomnia.yaml. Edit the Insomnia source and run npm run postman:generate.",
    "version": "0.1.0-beta6",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Payouts",
      "item": [
        {
          "name": "Schedule a payout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/payouts/schedule"
            },
            "description": "Public reference: https://studio.inttegro.com/payouts#schedule-a-payout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination_id\": \"{{financial_account_id}}\",\n  \"reference\": \"PAYOUT-APR-15\",\n  \"max_amount\": 250000,\n  \"execute_after\": \"{{future_timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const jsonBody = pm.response.json();",
                  "  const payout_id = jsonBody?.payout?.id;",
                  "  pm.test('Returns payout.id', () => {",
                  "    pm.expect(payout_id).to.be.a('string').and.not.be.empty;",
                  "  });",
                  "  if (payout_id) pm.environment.set(\"payout_id\", payout_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Lookup a payout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/payouts/lookup"
            },
            "description": "Public reference: https://studio.inttegro.com/payouts#lookup-a-payout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payout_id\": \"{{payout_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cancel a payout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
