            ],
            "url": {
              "raw": "{{base_url}}/payouts/page"
            },
            "description": "Public reference: https://studio.inttegro.com/payouts#page-through-payouts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page_number\": 1,\n  \"page_size\": 25\n}",
              "options": {
