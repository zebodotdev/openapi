            "url": {
              "raw": "{{base_url}}/payouts/set_destinations"
            },
            "description": "Public reference: https://studio.inttegro.com/payouts#set-payout-destinations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destinations\": {\n    \"ghs\": \"{{financial_account_id}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
