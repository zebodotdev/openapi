                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/payouts/cancel"
            },
            "description": "Public reference: https://studio.inttegro.com/payouts#cancel-a-payout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payout_id\": \"{{payout_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
