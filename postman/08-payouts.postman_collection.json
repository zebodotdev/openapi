        }
      ],
      "description": "Configure and manage payouts. Scheduling or changing settings can move money or alter payout behavior.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{api_key}}",
            "type": "string"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(",
              "  'future_timestamp',",
              "  new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString(),",
              ");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns a successful HTTP status', () => {",
              "  pm.expect(pm.response.code).to.be.within(200, 299);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": []
