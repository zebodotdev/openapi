{
  "info": {
    "name": "Inttegro API — Financial Accounts",
    "description": "Connect and manage collection and payout accounts. Uses the shared Inttegro API global environment.\n\nGenerated from insomnia/06-financial-accounts.insomnia.yaml. Edit the Insomnia source and run npm run postman:generate.",
    "version": "0.1.0-beta7",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Financial accounts",
      "item": [
        {
          "name": "Connect a financial account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/financial_accounts/connect"
            },
            "description": "Public reference: https://studio.inttegro.com/financial-accounts#connect-a-financial-account",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Konadu Tailoring Collections\",\n  \"reference\": \"KONADU-MOMO-SETTLEMENT\",\n  \"description\": \"Primary settlement wallet for Konadu B2C operations.\",\n  \"type\": \"wallet\",\n  \"currency\": \"ghs\",\n  \"owner\": {\n    \"name\": \"{{customer_name}}\",\n    \"address\": {\n      \"country\": \"GH\"\n    }\n  },\n  \"wallet\": {\n    \"type\": \"mobile_money\",\n    \"mobile_money\": {\n      \"network\": \"mtn\",\n      \"account_number\": \"{{mobile_money_account_number}}\"\n    }\n  },\n  \"push_configuration\": {\n    \"enabled\": true\n  },\n  \"pull_configuration\": {\n    \"enabled\": false\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const jsonBody = pm.response.json();",
                  "  const financial_account_id = jsonBody?.account?.id;",
                  "  pm.test('Returns account.id', () => {",
                  "    pm.expect(financial_account_id).to.be.a('string').and.not.be.empty;",
                  "  });",
                  "  if (financial_account_id) pm.environment.set(\"financial_account_id\", financial_account_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Disconnect a financial account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
