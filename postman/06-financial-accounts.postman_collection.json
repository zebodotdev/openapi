            },
            "description": "Public reference: https://studio.inttegro.com/financial-accounts#disconnect-a-financial-account",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{financial_account_id}}\",\n  \"unset_as_payout_destination\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
