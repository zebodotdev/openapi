            "description": "Public reference: https://studio.inttegro.com/financial-accounts#create-a-financial-account",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Marketplace Seller Sub-Account\",\n  \"reference\": \"SELLER-001-COLLECTION\",\n  \"description\": \"Dedicated collection account for seller 001.\",\n  \"type\": \"wallet\",\n  \"currency\": \"ghs\",\n  \"owner\": {\n    \"name\": \"{{customer_name}}\",\n    \"address\": {\n      \"country\": \"GH\"\n    }\n  },\n  \"wallet\": {\n    \"type\": \"mobile_money\",\n    \"mobile_money\": {\n      \"network\": \"mtn\",\n      \"account_number\": \"{{mobile_money_account_number}}\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const jsonBody = pm.response.json();",
                  "  const financial_account_id = jsonBody?.account?.id;",
                  "  pm.test('Returns account.id', () => {",
                  "    pm.expect(financial_account_id).to.be.a('string').and.not.be.empty;",
                  "  });",
                  "  if (financial_account_id) pm.environment.set(\"financial_account_id\", financial_account_id);",
                  "}"
                ]
              }
            }
          ]
        },
