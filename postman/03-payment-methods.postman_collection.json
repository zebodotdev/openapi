{
  "info": {
    "name": "Inttegro API — Payment Methods",
    "description": "Tokenize and manage saved payment methods. Uses the shared Inttegro API global environment.\n\nGenerated from insomnia/03-payment-methods.insomnia.yaml. Edit the Insomnia source and run npm run postman:generate.",
    "version": "0.1.0-beta2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Payment methods",
      "item": [
        {
          "name": "Tokenize payment method",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "call-payment-method-tokenize-001",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/payment_methods/tokenize"
            },
            "description": "Public reference: https://studio.inttegro.com/payment-methods#tokenize-payment-method",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"{{customer_id}}\",\n  \"type\": \"mobile_money\",\n  \"mobile_money\": {\n    \"account_number\": \"{{mobile_money_account_number}}\",\n    \"network\": \"mtn\"\n  },\n  \"owner\": {\n    \"name\": \"Jane Mensah\",\n    \"address\": {\n      \"country\": \"GH\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const jsonBody = pm.response.json();",
                  "  const payment_method_id = jsonBody?.payment_method?.id;",
                  "  pm.test('Returns payment_method.id', () => {",
                  "    pm.expect(payment_method_id).to.be.a('string').and.not.be.empty;",
                  "  });",
                  "  if (payment_method_id) pm.environment.set(\"payment_method_id\", payment_method_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Lookup payment method",
          "request": {
