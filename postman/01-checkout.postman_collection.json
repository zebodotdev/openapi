          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns a successful HTTP status', () => {",
              "  pm.expect(pm.response.code).to.be.within(200, 299);",
              "});"
            ]
          }
        }
