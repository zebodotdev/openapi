          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(",
              "  'future_timestamp',",
              "  new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString(),",
              ");"
            ]
          }
        },
