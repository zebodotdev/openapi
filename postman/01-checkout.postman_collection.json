{
  "info": {
    "name": "Inttegro API — Checkout and Orders",
    "description": "Create hosted checkout sessions and manage the complete order lifecycle. Uses the shared Inttegro API global environment.\n\nGenerated from insomnia/01-checkout.insomnia.yaml. Edit the Insomnia source and run npm run postman:generate.",
