  "item": [
    {
      "name": "Checkout and orders",
      "item": [
        {
          "name": "Create an order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/orders/create"
            },
            "description": "Public reference: https://studio.inttegro.com/orders#create-an-order. To execute immediately, provide payment_method_data together with execute_payment. Conflict reference: https://studio.inttegro.com/e/payment_transition_conflict",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_meta\": {\n    \"idempotency_key\": \"{{idempotency_key}}\"\n  },\n  \"number\": \"{{order_number}}\",\n  \"finalize\": true,\n  \"checkout_settings\": {\n    \"redirect_url\": \"{{checkout_success_url}}\",\n    \"cancel_url\": \"{{checkout_cancel_url}}\"\n  },\n  \"customer_data\": {\n    \"name\": \"{{customer_name}}\",\n    \"email_address\": \"{{customer_email}}\",\n    \"phone_number\": \"{{customer_phone}}\"\n  },\n  \"line_items\": [\n    {\n      \"type\": \"product\",\n      \"product\": {\n        \"type\": \"physical\",\n        \"name\": \"{{product_name}}\",\n        \"quantity\": 1,\n        \"price\": {\n          \"currency\": \"{{currency}}\",\n          \"value\": 20000\n        }\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const jsonBody = pm.response.json();",
                  "  const order_id = jsonBody?.order?.id;",
                  "  if (order_id) pm.environment.set(\"order_id\", order_id);",
                  "  const payment_id = jsonBody?.order?.payment?.id;",
                  "  if (payment_id) pm.environment.set(\"payment_id\", payment_id);",
                  "  const confirmation_id = jsonBody?.order?.payment?.next_action?.confirm_payment?.request?.id;",
                  "  if (confirmation_id) pm.environment.set(\"confirmation_id\", confirmation_id);",
                  "  const checkout_url = jsonBody?.order?.invoice?.format?.web?.url;",
                  "  if (checkout_url) pm.environment.set(\"checkout_url\", checkout_url);",
                  "  pm.test('Returns an order identifier', () => {",
                  "    pm.expect(order_id).to.be.a('string').and.not.be.empty;",
                  "  });",
                  "  pm.test('Returns a hosted checkout URL', () => {",
                  "    pm.expect(checkout_url).to.be.a('string').and.match(/^https?:\\/\\//);",
                  "  });",
                  "  const line_items = jsonBody?.order?.line_item_group?.line_items ?? [];",
                  "  const line_item_ids = line_items",
                  "    .map((line_item) => line_item?.product?.id ?? line_item?.fee?.id ?? line_item?.shipping?.id)",
                  "    .filter(Boolean);",
                  "  if (line_item_ids[0]) pm.environment.set(\"order_line_item_id\", line_item_ids[0]);",
                  "  pm.test('Returns typed order line item identifiers', () => {",
                  "    pm.expect(line_items).to.be.an('array').and.not.be.empty;",
                  "    pm.expect(line_item_ids.length).to.equal(line_items.length);",
                  "    for (const line_item_id of line_item_ids) {",
                  "      pm.expect(line_item_id).to.match(/^oli_/);",
                  "    }",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Pay for an order",
          "request": {
            "method": "POST",
            "header": [
