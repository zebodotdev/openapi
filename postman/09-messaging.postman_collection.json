          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Publishes the current message-template draft', () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  const template = pm.response.json()?.message_template;",
                  "  pm.expect(template?.id).to.equal(pm.variables.get('message_template_id'));",
                  "  pm.expect(template?.status).to.equal('published');",
                  "  pm.expect(template?.published_version).to.be.a('number');",
