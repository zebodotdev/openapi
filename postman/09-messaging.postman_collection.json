            }
          ]
        },
        {
          "name": "Page message templates",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/message_templates/page"
            },
            "description": "Public reference: https://studio.inttegro.com/message-templates#page-message-templates",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page\": 1,\n  \"size\": 25,\n  \"channel\": \"sms\",\n  \"status\": \"published\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns a published message-template page', () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  const page = pm.response.json()?.page;",
                  "  pm.expect(page?.number).to.equal(1);",
                  "  pm.expect(page?.size).to.equal(page?.message_templates?.length);",
                  "  const updated = page.message_templates.map((template) => Date.parse(template.updated_at));",
                  "  pm.expect(updated).to.deep.equal([...updated].sort((a, b) => b - a));",
                  "});"
                ]
