              "raw": "{\n  \"request_meta\": {\n    \"idempotency_key\": \"{{idempotency_key}}\"\n  },\n  \"recipients\": [\n    {\n      \"customer_id\": \"{{customer_id}}\",\n      \"transport\": \"sms\"\n    },\n    {\n      \"type\": \"phone\",\n      \"phone\": {\n        \"number\": \"{{customer_phone}}\"\n      },\n      \"name\": \"Backup Contact\"\n    }\n  ],\n  \"full_message\": \"Reminder: Your subscription renews tomorrow. Visit https://example.com/billing to update payment details.\",\n  \"send_after\": \"{{future_timestamp}}\",\n  \"sender_id\": \"YourBrand\",\n  \"purpose\": \"reminder\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 200', () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const jsonBody = pm.response.json();",
                  "  const schedule_id = jsonBody?.scheduled_chime?.id;",
                  "  pm.test('Returns scheduled_chime.id', () => {",
                  "    pm.expect(schedule_id).to.be.a('string').and.not.be.empty;",
                  "  });",
                  "  if (schedule_id) pm.environment.set(\"schedule_id\", schedule_id);",
                  "}"
                ]
              }
            }
          ]
