            ],
            "url": {
              "raw": "{{base_url}}/chimes/lookup"
            },
            "description": "Public reference: https://studio.inttegro.com/chimes#lookup-chime",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chime_id\": \"{{chime_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns a complete Chime', () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  const chime = pm.response.json()?.chime;",
                  "  pm.expect(chime).to.include.all.keys('id', 'created_at', 'full_message', 'recipient', 'sender_id');",
                  "  pm.expect(chime).not.to.have.property('delivery');",
                  "});"
                ]
              }
            }
          ]
        },
