    {
      "name": "Message templates",
      "item": [
        {
          "name": "Create a message template",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "call-template-create-shipping-update-sms",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/message_templates/create"
            },
            "description": "Public reference: https://studio.inttegro.com/message-templates#create-a-message-template",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Shipping update SMS\",\n  \"channel\": \"sms\",\n  \"purpose\": \"shipping_update\",\n  \"variables\": [\n    {\n      \"name\": \"customer_name\",\n      \"type\": \"string\",\n      \"required\": true\n    },\n    {\n      \"name\": \"tracking_url\",\n      \"type\": \"url\",\n      \"required\": true\n    }\n  ],\n  \"sms\": {\n    \"message_template\": \"{% raw %}Hi {{customer_name}}, your order shipped. Track it: {{tracking_url}}{% endraw %}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Creates a draft SMS message template', () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  const jsonBody = pm.response.json();",
                  "  const message_template_id = jsonBody?.message_template?.id;",
                  "  pm.expect(message_template_id).to.be.a('string').and.not.be.empty;",
                  "  pm.expect(jsonBody?.message_template?.channel).to.equal('sms');",
                  "  pm.expect(jsonBody?.message_template?.status).to.equal('draft');",
                  "  if (message_template_id) pm.environment.set(\"message_template_id\", message_template_id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update a message template",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "call-template-update-{{message_template_id}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/message_templates/update"
            },
            "description": "Public reference: https://studio.inttegro.com/message-templates#update-a-message-template",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{message_template_id}}\",\n  \"sms\": {\n    \"message_template\": \"{% raw %}Hi {{customer_name}}, your order shipped. Track: {{tracking_url}}{% endraw %}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Creates a new message-template draft version', () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  const template = pm.response.json()?.message_template;",
                  "  pm.expect(template?.id).to.equal(pm.variables.get('message_template_id'));",
                  "  pm.expect(template?.status).to.equal('draft');",
                  "  pm.expect(template?.has_unpublished_changes).to.equal(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Render a message template preview",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/message_templates/render_preview"
            },
            "description": "Public reference: https://studio.inttegro.com/message-templates#render-a-message-template-preview",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message_template\": {\n    \"template_id\": \"{{message_template_id}}\",\n    \"variables\": {\n      \"customer_name\": \"Gloria\",\n      \"tracking_url\": \"https://track.example.com/OR-12345\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Renders the current draft before publication', () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  const jsonBody = pm.response.json();",
                  "  pm.expect(jsonBody?.message_template?.id).to.equal(pm.variables.get('message_template_id'));",
                  "  pm.expect(jsonBody?.rendered?.channel).to.equal('sms');",
                  "  pm.expect(jsonBody?.rendered?.sms?.full_message).to.be.a('string').and.not.be.empty;",
                  "  pm.expect(jsonBody.rendered.sms.full_message.length).to.be.at.most(120);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Publish a message template",
          "request": {
            "method": "POST",
            "header": [
