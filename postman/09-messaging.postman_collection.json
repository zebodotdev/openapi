      "item": [
        {
          "name": "Send Chime",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/chimes/send"
            },
            "description": "Public reference: https://studio.inttegro.com/chimes#send-chime",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_meta\": {\n    \"idempotency_key\": \"{{idempotency_key}}\"\n  },\n  \"recipient\": {\n    \"customer_id\": \"{{customer_id}}\",\n    \"transport\": \"sms\"\n  },\n  \"full_message\": \"Your order #OR-12345 has been shipped and will arrive in 2-3 business days.\",\n  \"sender_id\": \"YourBrand\",\n  \"purpose\": \"shipping_update\",\n  \"custom_data\": {\n    \"order_id\": \"{{order_id}}\",\n    \"fulfillment_id\": \"ffl_xyz789\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 200', () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const jsonBody = pm.response.json();",
                  "  const chime_id = jsonBody?.chime?.id;",
                  "  pm.test('Returns chime.id', () => {",
                  "    pm.expect(chime_id).to.be.a('string').and.not.be.empty;",
                  "  });",
                  "  if (chime_id) pm.environment.set(\"chime_id\", chime_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Lookup Chime",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
