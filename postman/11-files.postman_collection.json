                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete a file",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/files/delete"
            },
            "description": "Public reference: https://studio.inttegro.com/files#delete-a-file",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_id\": \"{{file_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ],
      "description": "Upload, retrieve, download, page, and delete files.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{api_key}}",
            "type": "string"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(",
              "  'future_timestamp',",
              "  new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString(),",
              ");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns a successful HTTP status', () => {",
              "  pm.expect(pm.response.code).to.be.within(200, 299);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "File references",
      "item": [
        {
          "name": "Reconcile file references",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "call-file-references-{{product_id}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/file_references/reconcile"
            },
            "description": "Public reference: https://studio.inttegro.com/files#reconcile-file-references\nThis body replaces the complete reference set. Omitted existing references are removed; an empty or omitted list clears the set.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resource_type\": \"product\",\n  \"resource_id\": \"{{product_id}}\",\n  \"references\": [\n    {\n      \"file_id\": \"{{file_id}}\",\n      \"field\": \"media.gallery[0]\",\n      \"reference\": \"{{file_id}}\",\n      \"reference_kind\": \"file\",\n      \"purpose\": \"product_image\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Replaces the complete file-reference set', () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  pm.expect(pm.response.json()).to.deep.equal({ reconciled: true });",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Reconcile the files referenced by an Inttegro resource.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{api_key}}",
            "type": "string"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns a successful HTTP status', () => {",
              "  pm.expect(pm.response.code).to.be.within(200, 299);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "File links",
      "item": [
        {
          "name": "Create a file link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/file_links/create"
            },
            "description": "Public reference: https://studio.inttegro.com/file-links#create-a-file-link",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_id\": \"{{file_id}}\",\n  \"delivery\": {\n    \"mode\": \"inline\"\n  },\n  \"access\": {\n    \"allow_download\": true,\n    \"max_accesses\": 100\n  },\n  \"expires_at\": \"{{future_timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const jsonBody = pm.response.json();",
                  "  const file_link_id = jsonBody?.file_link?.id;",
                  "  if (file_link_id) pm.environment.set(\"file_link_id\", file_link_id);",
                  "  const file_link_url = jsonBody?.url;",
                  "  if (file_link_url) pm.environment.set(\"file_link_url\", file_link_url);",
                  "  pm.test('Returns file_link.id', () => {",
                  "    pm.expect(file_link_id).to.be.a('string').and.not.be.empty;",
                  "  });",
                  "  pm.test('Returns a file-link capability URL', () => {",
                  "    pm.expect(file_link_url).to.be.a('string').and.match(/^https?:\\/\\//);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Lookup a file link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/file_links/lookup"
            },
            "description": "Public reference: https://studio.inttegro.com/file-links#lookup-a-file-link",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{file_link_id}}\"\n}",
