{
  "info": {
    "name": "Inttegro API — Files",
    "description": "Upload files and manage file-link and third-party upload capabilities. Uses the shared Inttegro API global environment. Error reference: https://studio.inttegro.com/error-codes#file-apis\n\nGenerated from insomnia/11-files.insomnia.yaml. Edit the Insomnia source and run npm run postman:generate.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Files",
      "item": [
        {
          "name": "Upload a file",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/files/create"
            },
            "description": "Public reference: https://studio.inttegro.com/files#upload-a-file",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "purpose",
                  "value": "product_image",
                  "type": "text"
                },
                {
                  "key": "title",
                  "value": "Hero image",
                  "type": "text"
                },
                {
                  "key": "custom_data",
                  "value": "{\"product_ref\":\"SKU-12345\"}",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{upload_file_path}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const jsonBody = pm.response.json();",
                  "  const file_id = jsonBody?.file?.id;",
                  "  pm.test('Returns file.id', () => {",
                  "    pm.expect(file_id).to.be.a('string').and.not.be.empty;",
                  "  });",
                  "  if (file_id) pm.environment.set(\"file_id\", file_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Lookup a file",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/files/lookup"
            },
            "description": "Public reference: https://studio.inttegro.com/files#lookup-a-file",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_id\": \"{{file_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Page files",
          "request": {
            "method": "POST",
