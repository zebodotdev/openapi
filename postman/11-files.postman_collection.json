            ],
            "url": {
              "raw": "{{base_url}}/files/page"
            },
            "description": "Public reference: https://studio.inttegro.com/files#page-files",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"product_image\",\n  \"status\": \"available\",\n  \"page_number\": 1,\n  \"page_size\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Download file contents",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/files/contents"
            },
            "description": "Public reference: https://studio.inttegro.com/files#download-file-contents",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_id\": \"{{file_id}}\",\n  \"disposition\": \"attachment\"\n}",
              "options": {
