    {
      "name": "Upload requests",
      "item": [
        {
          "name": "Create an upload request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/upload_requests/create"
            },
            "description": "Public reference: https://studio.inttegro.com/file-uploads#create-an-upload-request",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"support_document\",\n  \"constraints\": {\n    \"content_types\": [\n      \"application/pdf\"\n    ],\n    \"max_size\": 10485760\n  },\n  \"display\": {\n    \"title\": \"Upload dispute evidence\",\n    \"help_text\": \"Attach a PDF under 10 MB.\"\n  },\n  \"recipient\": {\n    \"type\": \"customer\",\n    \"email\": \"ama@example.com\"\n  },\n  \"resource\": {\n    \"type\": \"dispute\",\n    \"id\": \"case_1001\"\n  },\n  \"custom_data\": {\n    \"case_id\": \"CASE-1001\"\n  },\n  \"expires_at\": \"{{future_timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const jsonBody = pm.response.json();",
                  "  const upload_request_id = jsonBody?.upload_request?.id;",
                  "  if (upload_request_id) pm.environment.set(\"upload_request_id\", upload_request_id);",
                  "  const upload_url = jsonBody?.upload_request?.upload_url;",
                  "  if (upload_url) pm.environment.set(\"upload_url\", upload_url);",
                  "  pm.test('Returns upload_request.id', () => {",
                  "    pm.expect(upload_request_id).to.be.a('string').and.not.be.empty;",
                  "  });",
                  "  pm.test('Returns an upload capability URL', () => {",
                  "    pm.expect(upload_url).to.be.a('string').and.match(/^https?:\\/\\//);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Fulfill an upload request",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{upload_url}}"
            },
            "description": "Public reference: https://studio.inttegro.com/file-uploads#fulfill-an-upload-request\nOpenAPI operation: POST /upload_requests/upload",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{upload_file_path}}"
                }
              ]
            }
          }
        },
        {
          "name": "Lookup an upload request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/upload_requests/lookup"
            },
            "description": "Public reference: https://studio.inttegro.com/file-uploads#lookup-an-upload-request",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{upload_request_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Review an upload request attempt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "call-upload-review-{{upload_request_id}}-1",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/upload_requests/review"
            },
            "description": "Public reference: https://studio.inttegro.com/file-uploads#review-an-upload-request-attempt",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{upload_request_id}}\",\n  \"attempt_ordinal\": 1,\n  \"decision\": \"rejected\",\n  \"reasons\": [\n    {\n      \"code\": \"document_unreadable\",\n      \"message\": \"The document is too blurry to read.\"\n    }\n  ],\n  \"public_message\": \"Please upload a clearer copy.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejects the latest fulfilled upload attempt and reopens the request', () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  const uploadRequest = pm.response.json()?.upload_request;",
                  "  pm.expect(uploadRequest?.id).to.equal(pm.variables.get('upload_request_id'));",
                  "  pm.expect(uploadRequest?.attempt?.ordinal).to.equal(1);",
                  "  pm.expect(uploadRequest?.attempt?.review?.decision).to.equal('rejected');",
                  "  pm.expect(uploadRequest?.attempt?.review?.public_message).to.equal('Please upload a clearer copy.');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Page upload requests",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
