              }
            ],
            "url": {
              "raw": "{{base_url}}/upload_requests/cancel"
            },
            "description": "Public reference: https://studio.inttegro.com/file-uploads#cancel-an-upload-request",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{upload_request_id}}\",\n  \"canceled_by\": {\n    \"type\": \"user\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ],
