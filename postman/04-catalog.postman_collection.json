{
  "info": {
    "name": "Inttegro API — Catalog",
    "description": "Create and manage products and prices. Uses the shared Inttegro API global environment.\n\nGenerated from insomnia/04-catalog.insomnia.yaml. Edit the Insomnia source and run npm run postman:generate.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "Create a product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "call-product-create-001",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products/create"
            },
            "description": "Public reference: https://studio.inttegro.com/products#create-a-product",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Premium Cotton T-Shirt\",\n  \"type\": \"physical\",\n  \"description\": \"Comfortable everyday wear\",\n  \"about\": \"Our premium cotton t-shirt is made from 100% organic cotton...\",\n  \"category\": \"clothing\",\n  \"attributes\": [\n    {\n      \"name\": \"Size\",\n      \"value\": \"Medium\"\n    },\n    {\n      \"name\": \"Color\",\n      \"value\": \"Blue\"\n    }\n  ],\n  \"media\": {\n    \"hero_image\": \"https://example.com/products/premium-shirt/hero.jpg\",\n    \"gallery\": [\n      \"https://example.com/products/premium-shirt/front.jpg\",\n      \"https://example.com/products/premium-shirt/back.jpg\"\n    ]\n  },\n  \"custom_data\": {\n    \"season\": \"summer\",\n    \"material\": \"organic_cotton\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const jsonBody = pm.response.json();",
                  "  const product_id = jsonBody?.product?.id;",
                  "  pm.test('Returns product.id', () => {",
                  "    pm.expect(product_id).to.be.a('string').and.not.be.empty;",
                  "  });",
                  "  if (product_id) pm.environment.set(\"product_id\", product_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Lookup a product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products/lookup"
            },
            "description": "Public reference: https://studio.inttegro.com/products#lookup-a-product",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"{{product_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Add a price to a product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "call-product-add-price-{{product_id}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products/add_price"
            },
            "description": "Public reference: https://studio.inttegro.com/products#add-a-price-to-a-product",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"{{product_id}}\",\n  \"label\": \"Wholesale\",\n  \"about\": \"Preferred rate for repeat buyers\",\n  \"amount\": {\n    \"currency\": \"ghs\",\n    \"value\": 85000\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const jsonBody = pm.response.json();",
                  "  const price_id = jsonBody?.price?.id;",
                  "  pm.test('Returns price.id', () => {",
                  "    pm.expect(price_id).to.be.a('string').and.not.be.empty;",
                  "  });",
                  "  pm.test('Returns a catalog price with a nominal amount', () => {",
                  "    pm.expect(jsonBody?.price?.active).to.be.a('boolean');",
                  "    pm.expect(jsonBody?.price?.nominal?.currency).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(jsonBody?.price?.nominal?.value).to.be.a('number');",
                  "    pm.expect(jsonBody?.price?.product_id).to.be.a('string').and.not.be.empty;",
                  "  });",
                  "  if (price_id) pm.environment.set(\"price_id\", price_id);",
                  "}"
                ]
              }
            }
          ]
        },
